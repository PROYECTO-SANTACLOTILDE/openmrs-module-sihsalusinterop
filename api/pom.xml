<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.openmrs.module</groupId>
        <artifactId>sihsalusinterop</artifactId>
        <version>1.0.3</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>sihsalusinterop-api</artifactId>
    <packaging>jar</packaging>
    <name>SIH SALUS Interoperability Module API</name>
    <description>API project for SIH SALUS Interoperability</description>

    <properties>
        <hapiFhirVersion>5.7.0</hapiFhirVersion>
    </properties>

    <dependencies>
        <!-- ========================================== -->
        <!-- OPENMRS CORE (CRÍTICO: SCOPE PROVIDED)     -->
        <!-- ========================================== -->
        <dependency>
            <groupId>org.openmrs.api</groupId>
            <artifactId>openmrs-api</artifactId>
            <type>jar</type>
            <scope>provided</scope> <!-- ¡ESTO EVITA EL ERROR OptionsForm! -->
        </dependency>

        <!-- ========================================== -->
        <!-- HAPI FHIR (CON EXCLUSIONES TOTALES)        -->
        <!-- ========================================== -->

        <!-- HAPI FHIR: scope=provided because fhir2 module already provides these at runtime.
             This avoids classloader conflicts (LinkageError on DateRangeParam, etc.) -->
        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>hapi-fhir-client</artifactId>
            <version>${hapiFhirVersion}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>hapi-fhir-structures-r4</artifactId>
            <version>${hapiFhirVersion}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>hapi-fhir-structures-dstu3</artifactId>
            <version>${hapiFhirVersion}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>ca.uhn.hapi.fhir</groupId>
            <artifactId>hapi-fhir-base</artifactId>
            <version>${hapiFhirVersion}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ========================================== -->
        <!-- JACKSON (PARA PRUEBAS MANUALES)            -->
        <!-- Necesario para serialización JSON FHIR    -->
        <!-- ========================================== -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.13.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>2.13.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>
            </plugin>
            <!-- Plugin para ejecutar la clase ManualTester -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>org.openmrs.module.sihsalusinterop.ManualTester</mainClass>
                    <classpathScope>test</classpathScope>
                    <includePluginDependencies>true</includePluginDependencies>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>